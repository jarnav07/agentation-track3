{
  "description": "EQ base: 12-agent latency-profile market (9 NoiseTrader, 1 MarketMaker, 2 ValueTrader) over a 20s horizon with a log-normal per-message latency model. Per-message latency realized by ScenarioLatencyModel from latency_config; the sampled per-message delays and their arrival ordering are the held-out object. Each EQ unit overrides only latency_config (model / magnitude / dispersion / clip window) and, where noted, order-flow density, so the varied axis is the event-scheduler/causality semantic a static-batched port cannot reproduce.",
  "scenario_family": "latency-profile",
  "schema_version": 2,
  "horizon_ns": 20000000000,
  "agent_mix": {
    "NoiseTrader": 9,
    "MarketMaker": 1,
    "ValueTrader": 2
  },
  "exchange_config": {
    "symbol": "SYM",
    "tick_size": 1,
    "lot_size": 1,
    "min_price": 1,
    "max_price": 1000000,
    "stp_policy": "cancel_newest",
    "order_types_allowed": [
      "LIMIT",
      "MARKET",
      "CANCEL",
      "REPLACE"
    ]
  },
  "oracle_config": {
    "type": "mean_reverting",
    "params": {
      "initial_price": 200000,
      "kappa": 0.05,
      "sigma": 0.001,
      "dt_ns": 1000000,
      "noise_type": "gaussian",
      "jump_intensity": 0.0,
      "jump_sigma": 0.0
    }
  },
  "latency_config": {
    "model": "uniform",
    "params": {
      "mean_ns": 50000,
      "sigma": 0.75,
      "min_ns": 100,
      "max_ns": 2000000
    }
  },
  "agent_configs": [
    {
      "agent_type": "NoiseTrader",
      "count": 9,
      "params": {
        "order_size_mean": 8,
        "order_size_std": 2,
        "arrival_rate_hz": 15.0,
        "price_offset_ticks": 5
      }
    },
    {
      "agent_type": "MarketMaker",
      "count": 1,
      "params": {
        "spread_ticks": 4,
        "depth_levels": 3,
        "size_per_level": 10,
        "rebalance_interval_ns": 500000000
      }
    },
    {
      "agent_type": "ValueTrader",
      "count": 2,
      "params": {
        "fundamental_value_source": "oracle",
        "order_size_mean": 40,
        "threshold_ticks": 5,
        "arrival_rate_hz": 1.0
      }
    }
  ],
  "output_config": {
    "trace_cols": [
      "t_ns",
      "agent_id",
      "msg_type",
      "side",
      "price",
      "size",
      "order_id"
    ],
    "events_fields": [
      "scenario_id",
      "n_events",
      "wall_clock_sec",
      "events_per_sec",
      "seed",
      "trace_sha256"
    ],
    "snapshot_interval_ns": 0
  },
  "tolerance": {
    "tier": "A",
    "timestamp_tolerance_ns": 1000,
    "kendall_tau_floor": 0.999,
    "spread_bps_tolerance": 10.0,
    "oracle_rmse_tolerance_pct": 20.0,
    "stylized_fact_ceilings": {
      "ks": 0.08,
      "acf_abs_l2": 0.12,
      "hill_abs": 1.5,
      "depth_js": 0.1
    }
  },
  "scenario_id": "50076583-ba35-52ab-b3f0-a82ad328f10d",
  "seed": 1127983136
}
